{{- with secret "kv/data/aegify/production/dashboard" -}}
AUTH_SECRET={{ .Data.data.auth_secret | toJSON }}
ENCRYPTION_SECRET={{ .Data.data.encryption_secret | toJSON }}
AUTH_URL={{ .Data.data.auth_url | toJSON }}
AUTH_ALLOWED_EMAILS={{ .Data.data.auth_allowed_emails | toJSON }}
AUTH_ADMIN_EMAILS={{ .Data.data.auth_admin_emails | toJSON }}
DATABASE_URL={{ .Data.data.database_url | toJSON }}
AUTH_GITHUB_ID={{ .Data.data.auth_github_id | toJSON }}
AUTH_GITHUB_SECRET={{ .Data.data.auth_github_secret | toJSON }}
{{- end }}
