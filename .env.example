# LLM verification (optional - scan works without it)
AEGIFY_ANTHROPIC_API_KEY=
# Six-agent provider adapters (optional)
OPENAI_API_KEY=

# Compose uses file:/data/dev.db when empty. For native development, set a writable local path.
DATABASE_URL=

# Auth.js dashboard authentication
# Generate independent secrets with: openssl rand -hex 32
AUTH_SECRET=
ENCRYPTION_SECRET=
AUTH_URL=http://localhost:3000
# Admission allows sign-in; projects require explicit membership.
# Exact workspace admins bootstrap project access and integration settings.
AUTH_ADMIN_EMAILS=
# No public signup by default.
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=
AUTH_LOCAL_ENABLED=false
# Email-first account activation and password recovery (Resend, verified sender).
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Only enable behind a trusted proxy that overwrites X-Forwarded-For.
AUTH_TRUST_PROXY=false
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_OKTA_ID=
AUTH_OKTA_SECRET=
AUTH_OKTA_ISSUER=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GITLAB_ID=
AUTH_GITLAB_SECRET=

# Issue expiring CI tokens from each project in the dashboard.
# Optional legacy credential: both values are required and bind it to one project.
AEGIFY_UPLOAD_TOKEN=
AEGIFY_UPLOAD_PROJECT_ID=

# Optional self-hosted Jira hosts, comma-separated. Atlassian Cloud
# (*.atlassian.net) is allowed without this override.
AEGIFY_JIRA_ALLOWED_HOSTS=

# DefectDojo integration (optional)
DEFECTDOJO_URL=
DEFECTDOJO_TOKEN=
DEFECTDOJO_ENGAGEMENT_ID=1

# Development-only docker-compose.defectdojo.yml credentials. Generate each
# independently; these values are not the DefectDojo API token above.
DD_DATABASE_PASSWORD=generate-a-random-secret-here
DD_SECRET_KEY=generate-a-random-secret-here
DD_CREDENTIAL_AES_256_KEY=generate-a-random-secret-here
DD_ADMIN_PASSWORD=generate-a-random-secret-here

# Optional Vault Agent/JWT integration. Applications consume injected environment
# variables; never commit VAULT_TOKEN or rendered secret files.
VAULT_ADDR=
VAULT_NAMESPACE=
VAULT_AUTH_METHOD=jwt
VAULT_ROLE=aegify-dashboard
