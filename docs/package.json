{
  "name": "aegify-documentation",
  "version": "0.3.0-beta.1",
  "private": true,
  "scripts": {
    "validate": "mint validate",
    "links": "mint broken-links --check-anchors --check-redirects --check-snippets",
    "a11y": "mint a11y",
    "check": "npm run validate && npm run links && npm run a11y",
    "dev": "mint dev"
  },
  "devDependencies": {
    "mint": "4.3.96"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.1",
    "express": "4.22.3",
    "puppeteer": "25.19.0",
    "puppeteer-core": "25.19.0",
    "qs": "6.17.1",
    "sharp": "0.35.5",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "adm-zip@<=0.6.0": "0.6.1"
  },
  "engines": {
    "node": ">=26.7.0 <27",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0"
}
