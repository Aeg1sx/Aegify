# Build from the repository root with Dockerfile.worker.dockerignore.
FROM ghcr.io/astral-sh/uv:0.12.17@sha256:10787c682e4184e4f290de1171fd4703dc63de99221f10fe1c99002ce7fa9acc AS uv
FROM node:26-bookworm-slim@sha256:662933cf47f013bc8e4beb31a6116448427a82057ba7c42c97e4c5ba766504c2 AS node
FROM python:3.14-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4 AS builder
COPY --from=uv /uv /bin/uv
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    apt-get update && apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /opt/aegify/scanner
COPY scanner/pyproject.toml scanner/uv.lock scanner/README.md scanner/hatch_build.py ./
COPY scanner/src/ src/
COPY rules/ /opt/aegify/rules/
RUN uv sync --locked --no-dev --no-editable
WORKDIR /opt/aegify/dashboard
COPY dashboard/package.json dashboard/package-lock.json dashboard/.npmrc ./
RUN npm ci --omit=dev --ignore-scripts
COPY dashboard/prisma ./prisma
COPY dashboard/prisma.config.ts ./prisma.config.ts
RUN node node_modules/prisma/build/index.js generate
COPY dashboard/src/lib ./src/lib
COPY dashboard/scripts/scan-worker.mjs dashboard/scripts/test-worker-container.mjs ./scripts/

FROM python:3.14-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --system --gid 1001 aegify && \
    useradd --system --uid 1001 --gid 1001 --home-dir /tmp --shell /usr/sbin/nologin aegify && \
    mkdir -p /data && chown 1001:1001 /data
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=builder /opt/aegify /opt/aegify
WORKDIR /opt/aegify/dashboard
ENV NODE_ENV=production
ENV PYTHONDONTWRITEBYTECODE=1
USER 1001:1001
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD ["node", "-e", "const fs=require('node:fs');process.exit(Date.now()-fs.statSync('/tmp/aegify-worker-health').mtimeMs<45000?0:1)"]
CMD ["node", "scripts/scan-worker.mjs"]
