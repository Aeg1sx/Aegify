generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id             String    @id @default(cuid())
  name           String
  repositoryUrl  String    @default("")
  defaultBranch  String    @default("main")
  description    String    @default("")
  color          String    @default("#6366f1")
  provider       String    @default("") // "github" | "gitlab" | ""
  providerRepoId String    @default("") // GitHub/GitLab numeric ID (string)
  ownerSlug      String    @default("") // "owner/repo" (GitHub) / "group/project" (GitLab)
  archived       Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  scans Scan[]
  findingIdentities FindingIdentity[]
  members ProjectMember[]
  serviceTokens ProjectServiceToken[]
  scanJobs ScanJob[]

  @@index([name])
  @@index([userId])
  @@index([archived])
}

model Scan {
  id                String   @id @default(cuid())
  repository        String   @default("")
  branch            String   @default("")
  commitSha         String   @default("")
  status            String   @default("completed") // pending, running, partial, completed, failed
  scanType          String   @default("sast") // sast, repo-ai-candidate, llm-quick, llm-deep
  filesScanned      Int      @default(0)
  duration          Float    @default(0)
  workspaceSnapshot String   @default("")
  createdAt         DateTime @default(now())

  // Progress tracking for running scans
  progressPhase     Int       @default(0)
  progressPhaseName String    @default("")
  progressPercent   Float     @default(0)
  progressMessage   String    @default("")
  progressEta       Float? // estimated seconds remaining
  progressUpdatedAt DateTime?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  findings   Finding[]
  graphNodes CallGraphNode[]
  graphEdges CallGraphEdge[]
  endpoints  Endpoint[]
  llmJobs    LlmJob[]
  agentRuns  AgentRun[]
  apiSpecifications ApiSpecification[]
  scanJob ScanJob?

  @@index([createdAt])
  @@index([repository])
  @@index([projectId])
}

model ScanJob {
  id                String   @id @default(cuid())
  scanId            String   @unique
  projectId         String
  requestedBy       String
  provider          String
  ownerSlug         String
  providerRepoId    String   @default("")
  requestedRef      String
  commitSha         String   @default("")
  sourceDigest      String   @default("")
  sourceManifest    String   @default("{}")
  sourceCiphertext  String?
  resultDigest      String   @default("")
  resultManifest    String   @default("{}")
  status            String   @default("queued")
  activeKey         String?  @unique
  attempts          Int      @default(0)
  maxAttempts       Int      @default(3)
  leaseToken        String?
  leaseExpiresAt    DateTime?
  heartbeatAt       DateTime?
  workerId          String   @default("")
  nextAttemptAt     DateTime @default(now())
  cancelRequestedAt DateTime?
  errorCode         String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  completedAt       DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  events ScanJobEvent[]

  @@index([status, nextAttemptAt, createdAt])
  @@index([leaseExpiresAt])
  @@index([projectId, createdAt])
}

model ScanJobEvent {
  id        Int      @id @default(autoincrement())
  jobId     String
  code      String
  message   String
  details   String   @default("{}")
  createdAt DateTime @default(now())
  job ScanJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([jobId, id])
}

model ScanWorker {
  id          String   @id
  version     String
  lastSeenAt  DateTime @default(now())
  startedAt   DateTime @default(now())
  @@index([lastSeenAt])
}

model Finding {
  id             String   @id @default(cuid())
  scanId         String
  ruleId         String
  ruleName       String
  severity       String // critical, high, medium, low
  confidence     Float    @default(0.8)
  evidenceState  String   @default("candidate") // candidate, reachable, observed, impact_proven
  disposition    String   @default("advisory") // blocking, advisory
  status         String   @default("open") // open, triaged, confirmed, in_progress, false_positive, fixed
  source         String   @default("sast") // sast, llm
  filePath       String
  lineStart      Int
  lineEnd        Int
  codeSnippet    String   @default("")
  message        String
  cweId          Int?
  owaspCategory  String?
  taintFlow      String? // JSON string of taint flow
  callChain      String? // JSON string of call chain
  defenseContext String? // JSON string of defense context
  remediation    String?
  llmAnalysis    String? // JSON string of LLM analysis result
  evidenceId     String   @default("")
  repositoryId   String   @default("")
  modulePath     String   @default("")
  provenance     String   @default("{}") // JSON evidence producer contract
  fingerprint    String   @default("")
  baselineState  String   @default("new") // new, unchanged, updated, regressed
  identityId     String   @default("")
  isCurrent      Boolean  @default(true) // latest occurrence for project-level views
  aiVerdict      String   @default("") // suggestion only; never changes status implicitly
  aiConfidence   Float?
  aiReviewStatus String   @default("unreviewed") // unreviewed, suggested, accepted, rejected
  aiProof         String   @default("{}") // bounded PoC/payload/harness guidance
  owner           String   @default("")
  dueAt           DateTime?
  priority        String   @default("")
  tags            String   @default("[]")
  ticketProvider  String   @default("")
  ticketKey       String   @default("")
  ticketUrl       String   @default("")
  lastNotifiedAt  DateTime?
  createdAt      DateTime @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([severity])
  @@index([disposition])
  @@index([status])
  @@index([ruleId])
  @@index([filePath])
  @@index([source])
  @@index([evidenceId])
  @@index([repositoryId])
  @@index([fingerprint])
  @@index([baselineState])
  @@index([identityId])
  @@index([isCurrent])
  @@index([owner])
  @@index([dueAt])
  @@index([ticketKey])
}

model FindingIdentity {
  id                 String    @id @default(cuid())
  projectId          String
  fingerprint        String
  ruleId             String
  filePath           String
  repositoryId       String    @default("")
  modulePath         String    @default("")
  status             String    @default("open")
  firstSeenAt        DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  lastSeenScanId     String    @default("")
  occurrenceCount    Int       @default(1)
  absentAt           DateTime?
  lastSeverity       String    @default("")
  lastEvidenceState  String    @default("")
  lastMessageDigest  String    @default("")
  triageReason       String    @default("")
  triageActor        String    @default("")
  triageExpiresAt    DateTime?
  owner              String    @default("")
  dueAt              DateTime?
  priority           String    @default("")
  tags               String    @default("[]")
  ticketProvider     String    @default("")
  ticketKey          String    @default("")
  ticketUrl          String    @default("")
  lastNotifiedAt     DateTime?
  workflowRevision   Int       @default(0)
  workflowNeedsReview Boolean  @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  triageEvents FindingTriageEvent[]

  @@unique([projectId, fingerprint])
  @@index([projectId, status])
  @@index([lastSeenScanId])
  @@index([projectId, repositoryId, modulePath, ruleId])
}

model FindingTriageEvent {
  id          String   @id @default(cuid())
  identityId  String
  fromStatus  String
  toStatus    String
  reason      String   @default("")
  actor       String   @default("")
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  identity FindingIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, createdAt])
}

model Rule {
  id            String   @id
  name          String
  severity      String
  cweId         Int?
  owaspCategory String?
  languages     String   @default("") // comma-separated
  enabled       Boolean  @default(true)
  findingCount  Int      @default(0)
  yamlContent   String   @default("") // YAML rule definition (patterns, etc.)
  description   String   @default("")
  sourceFile    String   @default("") // tracks which YAML file this rule came from
  updatedAt     DateTime @default(now()) @updatedAt
}

model Setting {
  key       String   @id
  value     String // encrypted for sensitive values
  encrypted Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt
}

model CallGraphNode {
  id              String  @id @default(cuid())
  scanId          String
  qualifiedName   String
  filePath        String
  lineStart       Int     @default(0)
  lineEnd         Int     @default(0)
  nodeType        String  @default("function") // function, method, entry_point, sink, module
  hasFinding      Boolean @default(false)
  findingSeverity String? // highest severity finding on this node

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  outEdges CallGraphEdge[] @relation("SourceNode")
  inEdges  CallGraphEdge[] @relation("TargetNode")

  @@unique([scanId, qualifiedName])
  @@index([scanId])
}

model CallGraphEdge {
  id           String @id @default(cuid())
  scanId       String
  sourceNodeId String
  targetNodeId String
  callSiteLine Int    @default(0)

  scan       Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  sourceNode CallGraphNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode CallGraphNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model Endpoint {
  id                      String  @id @default(cuid())
  scanId                  String
  path                    String
  method                  String
  handlerFunction         String
  filePath                String
  lineStart               Int     @default(0)
  lineEnd                 Int     @default(0)
  framework               String  @default("")
  authRequired            Boolean @default(false)
  parameters              String  @default("[]") // JSON
  middleware              String  @default("[]") // JSON
  repositoryId            String  @default("")
  calledByFrontend        Boolean @default(false)
  frontendCallCount       Int     @default(0)
  frontendEvidence        String  @default("[]") // JSON evidence with file and line
  exposedViaGateway       Boolean @default(false)
  gatewayRouteIds         String  @default("[]") // JSON
  gatewayEvidence         String  @default("[]") // JSON evidence with route source
  runtimeObserved         Boolean @default(false)
  runtimeObservationCount Int     @default(0)
  runtimeEvidence         String  @default("[]") // JSON redacted HTTP/browser/trace evidence

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, repositoryId, path, method])
  @@index([scanId])
}

model ApiSpecification {
  id             String   @id @default(cuid())
  scanId         String
  repositoryId   String   @default("")
  sourceType     String
  sourceName     String
  sourceUrl      String   @default("")
  contentHash    String
  title          String
  specVersion    String
  apiVersion     String
  contract       String
  operationCount Int
  createdAt      DateTime @default(now())
  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, repositoryId, contentHash])
  @@index([scanId, repositoryId, createdAt])
}

model LlmJob {
  id             String    @id @default(cuid())
  scanId         String
  activeKey      String?   @unique // scan ID while pending/running; null after terminal state
  mode           String // "quick" | "deep"
  status         String    @default("pending") // pending, running, partial, completed, failed
  totalFindings  Int       @default(0)
  reviewedCount  Int       @default(0)
  falsePositives Int       @default(0)
  currentBatch   Int       @default(0)
  totalBatches   Int       @default(0)
  errorMessage   String    @default("")
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([scanId])
  @@index([createdAt])
}

model AgentRun {
  id                String    @id @default(cuid())
  scanId            String
  mode              String    @default("deep") // lite, deep
  provider          String    @default("deterministic")
  status            String    @default("running") // running, awaiting_approval, completed, partial, failed, cancelled
  currentRole       String    @default("surface")
  workspaceSnapshot String    @default("")
  requestPayload    String    @default("{}")
  artifactDigest    String    @default("")
  errorMessage      String    @default("")
  createdAt         DateTime  @default(now())
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  scan       Scan                  @relation(fields: [scanId], references: [id], onDelete: Cascade)
  stages     AgentStage[]
  approvals  AgentApproval[]
  events     AgentEvent[]
  evidence   AgentEvidenceRecord[]

  @@index([scanId])
  @@index([status])
  @@index([createdAt])
}

model AgentStage {
  id                   String    @id @default(cuid())
  runId                String
  sequence             Int
  role                 String
  agentCode            String
  agentName            String
  status               String    @default("pending")
  summary              String    @default("")
  facts                String    @default("{}")
  evidenceIds          String    @default("[]")
  reachability         String    @default("[]")
  dynamicPlans         String    @default("[]")
  cveAssessments       String    @default("[]")
  improvementProposals String    @default("[]")
  narrative            String    @default("{}")
  promptDigest         String    @default("")
  errorMessage         String    @default("")
  startedAt            DateTime  @default(now())
  completedAt          DateTime?

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, role])
  @@index([status])
}

model AgentApproval {
  id            String    @id @default(cuid())
  runId         String
  action        String    @default("dynamic_validation")
  resourceId    String
  status        String    @default("pending") // pending, approved, rejected, consumed, expired
  scopeDigest   String
  requestedBy   String    @default("")
  decidedBy     String    @default("")
  decisionNote  String    @default("")
  requestedAt   DateTime  @default(now())
  decidedAt     DateTime?
  expiresAt     DateTime?

  run      AgentRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidence AgentEvidenceRecord[]

  @@unique([runId, resourceId])
  @@index([runId, status])
  @@index([expiresAt])
}

model AgentEvent {
  id        String   @id @default(cuid())
  runId     String
  type      String
  actor     String   @default("system")
  message   String
  payload   String   @default("{}")
  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

model AgentEvidenceRecord {
  id          String   @id @default(cuid())
  runId       String
  approvalId  String?
  kind        String
  producer    String
  status      String
  digest      String
  payload     String
  createdAt   DateTime @default(now())

  run      AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  approval AgentApproval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  @@unique([runId, digest])
  @@index([runId, kind])
  @@index([approvalId])
}

// Auth.js (NextAuth v5) models
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  image         String?
  emailVerified DateTime?
  username      String?   @unique
  passwordHash  String?
  sessionVersion Int      @default(0)
  sessionEpoch   String   @default("") // Rotated after recovery; counters alone can repeat after rollback.
  disabled      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  projectMemberships ProjectMember[]
}

model ProjectMember {
  projectId String
  userId String
  role String // viewer, triager, maintainer, admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model ProjectServiceToken {
  id String @id @default(cuid())
  projectId String
  name String
  tokenHash String @unique
  prefix String
  scope String @default("scan:upload")
  createdBy String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  lastUsedAt DateTime?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([expiresAt])
}

model AuditEvent {
  id String @id @default(cuid())
  projectId String? // Retain the original ID after deletion; deliberately no cascade.
  actorId String
  action String
  targetId String
  details String @default("{}")
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuthActionToken {
  tokenHash  String   @id
  identifier String
  purpose    String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, purpose])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
